{
  "expo": {
    "name": "Verde Real",
    "slug": "verde-real",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verdereal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Usado para anexar fotos e vídeos como prova nas denúncias ambientais.",
        "NSCameraUsageDescription": "Usado para tirar fotos na hora de registrar uma denúncia.",
        "NSLocationWhenInUseUsageDescription": "Usado para anexar o local da denúncia, quando você escolher compartilhar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#10221A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usado para anexar fotos e vídeos como prova nas denúncias ambientais."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usado para anexar o local da denúncia, quando você escolher compartilhar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#407a6c"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}